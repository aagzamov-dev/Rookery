{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rookery",
  "version": "0.8.0",
  "identifier": "app.rookery.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../apps/desktop"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../apps/desktop"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rookery",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#1B2230"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Rookery",
    "category": "DeveloperTool",
    "shortDescription": "Local-first SSH, SFTP, Docker and server dashboard",
    "longDescription": "Rookery is a local-first server manager: terminal, SFTP, Docker and monitoring. Everything stays on this computer.",
    "copyright": "© 2026 Rookery",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0M0EwRjI0Q0M4QTgwMTUKUldRVmdJck1KQTg2SkR1ZHhiV3hhUHB4VDFoOEszV0k4U2Rjc3lhWDdzY2pySk9kS0pvbU1tZGMK",
      "endpoints": [
        "https://github.com/aagzamov-dev/Rookery/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
